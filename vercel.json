{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/public/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ],
  "redirects": [
    { "source": "/hub", "destination": "/aquaculture/", "permanent": false },
    { "source": "/roi", "destination": "/aquaculture/#/roi", "permanent": false }
  ]
}
